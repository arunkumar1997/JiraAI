{
    "name": "jira-ai-mcp-server",
    "version": "1.0.0",
    "description": "AI-powered Agile workflow automation via MCP — transforms meeting summaries into JIRA artifacts with human-in-the-loop approval",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "jira-ai-mcp": "dist/index.js"
    },
    "scripts": {
        "build": "prisma generate && tsc",
        "start": "node dist/index.js",
        "dev": "tsx src/index.ts",
        "dev:watch": "tsx watch src/index.ts",
        "typecheck": "tsc --noEmit",
        "test": "node --experimental-vm-modules node_modules/.bin/jest --passWithNoTests",
        "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
        "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
        "clean": "rm -rf dist",
        "lint": "eslint 'src/**/*.ts'",
        "db:migrate": "prisma migrate deploy",
        "db:push": "prisma db push",
        "db:studio": "prisma studio",
        "db:generate": "prisma generate",
        "ingest-docs": "tsx src/scripts/ingest-docs.ts",
        "docker:db:migrate": "docker compose run --rm jira-ai-mcp node_modules/.bin/prisma migrate deploy",
        "docker:db:studio": "docker compose run --rm -p 5555:5555 jira-ai-mcp npx prisma studio --port 5555 --browser none",
        "docker:ingest-docs": "docker compose run --rm jira-ai-mcp node dist/scripts/ingest-docs.js",
        "ollama:start": "docker compose up -d ollama",
        "ollama:stop": "docker compose stop ollama",
        "ollama:pull": "docker exec ollama ollama pull ${EMBEDDING_MODEL:-nomic-embed-text}",
        "ollama:logs": "docker compose logs -f ollama",
        "ollama:setup": "npm run ollama:start && echo 'Waiting for Ollama...' && sleep 5 && npm run ollama:pull"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "latest",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@types/pg": "^8.20.0",
        "axios": "latest",
        "dotenv": "latest",
        "pg": "^8.21.0",
        "prisma": "^7.8.0",
        "uuid": "latest",
        "winston": "latest",
        "zod": "latest"
    },
    "devDependencies": {
        "@types/jest": "latest",
        "@types/node": "latest",
        "@types/uuid": "latest",
        "@typescript-eslint/eslint-plugin": "latest",
        "@typescript-eslint/parser": "latest",
        "eslint": "latest",
        "jest": "latest",
        "ts-jest": "latest",
        "tsx": "latest",
        "typescript": "latest"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "jest": {
        "preset": "ts-jest/presets/default-esm",
        "extensionsToTreatAsEsm": [
            ".ts"
        ],
        "transform": {
            "^.+\\.tsx?$": [
                "ts-jest",
                {
                    "useESM": true
                }
            ]
        },
        "moduleNameMapper": {
            "^(\\.{1,2}/.*)\\.js$": "$1"
        },
        "testEnvironment": "node",
        "testMatch": [
            "**/__tests__/**/*.test.ts"
        ]
    }
}